{
 "schema": 1,
 "version": "2.0.0",
 "about": "Steps as data (KIT_SPEC 6.11). Executed in order; a step whose `when` fails is skipped. Types: SCRIPT, DISPATCH, HUMAN, HOST. Predicates, fanouts and scripts live in ublib/engine/registry.py.",
 "steps": [
  {"id": "0.1", "stage": 0, "title": "Create the run", "type": "SCRIPT", "script": "noop"},
  {"id": "0.2", "stage": 0, "title": "Kickoff", "type": "HUMAN", "gate": "G0"},
  {"id": "0.3", "stage": 0, "title": "Apply the kickoff", "type": "SCRIPT", "script": "apply_kickoff"},

  {"id": "1.1", "stage": 1, "title": "Your seeds", "type": "HUMAN", "gate": "G1", "when": ["hands_on", "no_seeds"]},
  {"id": "1.2", "stage": 1, "title": "BMAD seeds session", "type": "HOST",
   "when": ["deep", "has_component:bmad_brainstorming", "host_can_run_skills", "not_full_auto"],
   "host": {"template": "BMAD-SEEDS", "skills": ["bmad_brainstorming"], "writes": ["00_HUMAN_SEEDS.md"]}},

  {"id": "2.0", "stage": 2, "title": "Repository snapshot", "type": "SCRIPT", "script": "context_snapshot",
   "when": ["repo_variant", "not_quick"], "outputs": ["CONTEXT.before.md", "frame/footprint.json"]},
  {"id": "2.1gd", "stage": 2, "title": "Frame with grilling and domain-modeling", "type": "HOST",
   "when": ["repo_variant", "has_component:grilling", "has_component:domain_modeling", "host_can_run_skills",
            "not_full_auto", "not_quick"],
   "host": {"template": "FRAME-GRILL-DOCS", "skills": ["grilling", "domain_modeling"],
            "writes": ["01_FRAME.md", "criteria.json"]},
   "outputs": ["01_FRAME.md", "criteria.json", "CONTEXT.proposed.md"]},
  {"id": "2.1g", "stage": 2, "title": "Frame with grilling", "type": "HOST",
   "when": ["has_component:grilling", "host_can_run_skills", "not_full_auto", "not_quick", "step_skipped:2.1gd"],
   "host": {"template": "FRAME-GRILL", "skills": ["grilling"], "writes": ["01_FRAME.md", "criteria.json"]},
   "outputs": ["01_FRAME.md", "criteria.json"]},
  {"id": "2.1q", "stage": 2, "title": "Frame questions", "type": "DISPATCH", "fanout": "frame_questions",
   "when": ["not_quick", "not_full_auto", "step_skipped:2.1g", "step_skipped:2.1gd"],
   "job": {"kind": "frame"}, "min_ok": 1},
  {"id": "2.1a", "stage": 2, "title": "Frame answers", "type": "HUMAN", "gate": "G2", "when": ["step_done:2.1q"]},
  {"id": "2.1w", "stage": 2, "title": "Write the frame", "type": "DISPATCH", "fanout": "frame_files",
   "when": ["step_done:2.1q"], "job": {"kind": "frame"}, "min_ok": 1, "outputs": ["01_FRAME.md", "criteria.json"]},
  {"id": "2.1f", "stage": 2, "title": "Draft the frame (full-auto)", "type": "DISPATCH", "fanout": "frame_files",
   "when": ["full_auto", "not_quick"], "job": {"kind": "frame"}, "min_ok": 1,
   "outputs": ["01_FRAME.md", "criteria.json"]},
  {"id": "2.1k", "stage": 2, "title": "Mini frame (quick)", "type": "SCRIPT", "script": "quick_frame",
   "when": ["mode_is:quick"], "outputs": ["01_FRAME.md", "criteria.json"]},
  {"id": "2.2", "stage": 2, "title": "Check the frame", "type": "SCRIPT", "script": "frame_check",
   "outputs": ["frame/lint.json"]},
  {"id": "2.2f", "stage": 2, "title": "Repository docs changed", "type": "HUMAN", "gate": "G2f",
   "when": ["footprint_changed"]},
  {"id": "2.3", "stage": 2, "title": "Confirm the frame", "type": "HUMAN", "gate": "G2c",
   "when": ["hands_on", "not_quick"]},

  {"id": "Q.2", "stage": 4, "title": "Quick generation", "type": "DISPATCH", "fanout": "quick_gen",
   "when": ["mode_is:quick"], "job": {"kind": "generator"}, "min_ok": 1, "after": ["write_pool_families"]},
  {"id": "Q.3", "stage": 5, "title": "Quick curation", "type": "DISPATCH", "fanout": "quick_curate",
   "when": ["mode_is:quick"], "job": {"kind": "curator"}, "min_ok": 1},
  {"id": "Q.4", "stage": 6, "title": "Quick pick", "type": "SCRIPT", "script": "quick_pick", "when": ["mode_is:quick"],
   "outputs": ["quick/finalists.json", "tournament/cards.md", "origins.json"]},

  {"id": "3.1", "stage": 3, "title": "Ground", "type": "DISPATCH", "fanout": "ground", "when": ["not_quick"],
   "job": {"kind": "researcher"}, "min_ok": 1},
  {"id": "3.1b", "stage": 3, "title": "Ground (second family)", "type": "DISPATCH", "fanout": "ground2",
   "when": ["deep"], "job": {"kind": "researcher"}, "min_ok": 0},
  {"id": "3.2", "stage": 3, "title": "Merge the landscapes", "type": "SCRIPT", "script": "merge_ground",
   "when": ["deep"]},

  {"id": "P.1", "stage": 4, "title": "Your idea as I-001", "type": "SCRIPT", "script": "proposal_idea",
   "when": ["mode_is:proposal"],
   "outputs": ["screen/ideas.md", "origins.json", "primary.json", "clusters.json"]},
  {"id": "P.2", "stage": 8, "title": "Contrast variants", "type": "DISPATCH", "fanout": "evolve_contrast",
   "when": ["mode_is:proposal"], "job": {"kind": "generator"}, "min_ok": 1, "after": ["add_evolved"]},

  {"id": "4.0", "stage": 4, "title": "Judge and lens schemas", "type": "SCRIPT", "script": "bs_schemas",
   "when": ["deep"]},
  {"id": "4.1c", "stage": 4, "title": "S1 with ce-ideate", "type": "HOST",
   "when": ["not_quick", "!mode_is:proposal", "s1_engine:ce-ideate", "host_can_run_skills"],
   "host": {"template": "S1-CE", "skills": ["ce_ideate"], "writes": ["pool/S1_ce-ideate.md"], "optional": true},
   "after": ["s1_after"],
   "outputs": ["pool/S1_ce-ideate.md", "pool/S1_ce-ideate_raw.md"]},
  {"id": "4.1f", "stage": 4, "title": "S1 frame fan-out", "type": "DISPATCH", "fanout": "s1f",
   "when": ["not_quick", "!mode_is:proposal", "step_skipped:4.1c"], "job": {"kind": "generator"}, "min_ok": 0},
  {"id": "4.2", "stage": 4, "title": "Diverge", "type": "DISPATCH", "fanout": "strategies",
   "when": ["not_quick", "!mode_is:proposal"], "job": {"kind": "generator"}, "min_ok": "3/5",
   "after": ["write_pool_families"]},
  {"id": "4.3", "stage": 4, "title": "Pool families", "type": "SCRIPT", "script": "write_pool_families",
   "when": ["not_quick", "!mode_is:proposal"], "outputs": ["pool/_families.json"]},

  {"id": "5.1", "stage": 5, "title": "Curate the pool", "type": "DISPATCH", "fanout": "curator",
   "when": ["not_quick", "!mode_is:proposal"], "job": {"kind": "curator"}, "min_ok": 1,
   "after": ["convert_merges"], "outputs": ["merges.json", "03_POOL_NOTES.md"]},
  {"id": "5.2", "stage": 5, "title": "Map the pool", "type": "SCRIPT", "script": "bs_map",
   "when": ["not_quick", "!mode_is:proposal"],
   "outputs": ["03_POOL.md", "clusters.json", "origins.json", "primary.json", "screen/ideas.md", "coverage.json",
               "screen/dupcheck.txt"]},
  {"id": "5.2d", "stage": 5, "title": "Curate again (near-duplicates)", "type": "DISPATCH", "fanout": "curator",
   "when": ["deep"], "job": {"kind": "curator"}, "min_ok": 1, "after": ["convert_merges"]},
  {"id": "5.2m", "stage": 5, "title": "Map again", "type": "SCRIPT", "script": "bs_map", "when": ["deep"]},
  {"id": "5.3", "stage": 5, "title": "Gap round", "type": "DISPATCH", "fanout": "gap_cells",
   "when": ["not_quick", "!mode_is:proposal", "homogenized_or_gaps"], "job": {"kind": "generator"}, "min_ok": 1,
   "conditional": true, "loops": true, "rounds_deep": 2, "after": ["write_pool_families"]},
  {"id": "5.3c", "stage": 5, "title": "Curate after the gap round", "type": "DISPATCH", "fanout": "curator",
   "when": ["step_done:5.3"], "job": {"kind": "curator"}, "min_ok": 1, "conditional": true,
   "loops": true, "rounds_deep": 2, "after": ["convert_merges"]},
  {"id": "5.3m", "stage": 5, "title": "Map after the gap round", "type": "SCRIPT", "script": "gap_round_end",
   "when": ["step_done:5.3"]},
  {"id": "5.4", "stage": 5, "title": "Human round 2", "type": "HUMAN", "gate": "G3",
   "when": ["hands_on", "not_quick", "!mode_is:proposal"], "outputs": ["00b_HUMAN_ROUND2.md"]},
  {"id": "5.4c", "stage": 5, "title": "Curate your round-2 ideas", "type": "DISPATCH", "fanout": "curator",
   "when": ["has_round2", "not_quick", "!mode_is:proposal"], "job": {"kind": "curator"}, "min_ok": 1,
   "conditional": true, "after": ["convert_merges"]},
  {"id": "5.4m", "stage": 5, "title": "Map again", "type": "SCRIPT", "script": "bs_map",
   "when": ["has_round2", "not_quick", "!mode_is:proposal"]},

  {"id": "6.1", "stage": 6, "title": "Prepare the screen", "type": "SCRIPT", "script": "prepare_screen",
   "when": ["not_quick", "!mode_is:proposal"],
   "outputs": ["screen/header.md", "screen/*.prompt.md", "screen/screen.schema.json",
               "tournament/verdicts.schema.json", "prompts/lens.schema.json"]},
  {"id": "6.2", "stage": 6, "title": "Screen judges", "type": "DISPATCH", "fanout": "screen_judges",
   "when": ["not_quick", "!mode_is:proposal"], "job": {"kind": "judge"}, "min_ok": 2},
  {"id": "6.3", "stage": 6, "title": "Screen tally", "type": "SCRIPT", "script": "screen_tally",
   "when": ["not_quick", "!mode_is:proposal"],
   "outputs": ["screen/table.md", "screen/shortlist.json", "04_SHORTLIST.md"]},
  {"id": "6.4", "stage": 6, "title": "Rescues", "type": "HUMAN", "gate": "G4",
   "when": ["not_quick", "!mode_is:proposal"]},

  {"id": "7.1", "stage": 7, "title": "Reality checks", "type": "DISPATCH", "fanout": "shortlist",
   "when": ["not_quick"], "job": {"kind": "checker"}, "min_ok": "2/3"},
  {"id": "7.2", "stage": 7, "title": "K4 candidates", "type": "SCRIPT", "script": "k4",
   "when": ["not_quick", "!mode_is:proposal"]},
  {"id": "7.3", "stage": 7, "title": "Confirm K4 kills", "type": "HUMAN", "gate": "G5",
   "when": ["not_quick", "!mode_is:proposal", "k4_candidates"]},

  {"id": "8.0", "stage": 8, "title": "Evolve (skipped)", "type": "SCRIPT", "script": "evolve_skipped",
   "when": ["not_quick", "!mode_is:proposal", "!evolve_needed"], "outputs": ["05_EVOLVED.md"]},
  {"id": "8.1", "stage": 8, "title": "Evolve", "type": "DISPATCH", "fanout": "evolve",
   "when": ["not_quick", "!mode_is:proposal", "evolve_needed"], "job": {"kind": "generator"}, "min_ok": 0,
   "conditional": true, "after": ["add_evolved"]},
  {"id": "8.2", "stage": 8, "title": "Check the evolved ideas", "type": "DISPATCH", "fanout": "evolved",
   "when": ["step_done:8.1"], "job": {"kind": "checker"}, "min_ok": 0, "conditional": true},

  {"id": "9.1", "stage": 9, "title": "Finalists", "type": "SCRIPT", "script": "finalists",
   "when": ["!mode_is:quick"]},
  {"id": "9.1h", "stage": 9, "title": "Choose finalists", "type": "HUMAN", "gate": "G6",
   "when": ["!mode_is:quick", "!mode_is:proposal", "more_than_8"]},
  {"id": "9.2", "stage": 9, "title": "Neutral cards", "type": "DISPATCH", "fanout": "normalizer",
   "when": ["!mode_is:quick"], "job": {"kind": "normalizer"}, "min_ok": 1},
  {"id": "9.3", "stage": 9, "title": "Prepare the tournament", "type": "SCRIPT", "script": "prepare_tournament",
   "outputs": ["tournament/header.md", "tournament/*.prompt.md", "tournament/*.map.json"]},
  {"id": "9.5", "stage": 9, "title": "Gut pick", "type": "HUMAN", "gate": "G8a", "prelaunch": ["9.4"],
   "prelaunch_when": ["!hands_on"], "outputs": ["tournament/precommit.md"]},
  {"id": "9.4", "stage": 9, "title": "Tournament judges", "type": "DISPATCH", "fanout": "tournament_prompts",
   "job": {"kind": "judge"}, "min_ok": "1/2"},
  {"id": "9.6", "stage": 9, "title": "Tournament tally", "type": "SCRIPT", "script": "tournament_tally",
   "outputs": ["tournament/result.md", "tournament/result.json", "06_TOURNAMENT.md"]},

  {"id": "Q.7", "stage": 10, "title": "Decide", "type": "HUMAN", "gate": "G8b", "when": ["mode_is:quick"]},
  {"id": "Q.6", "stage": 11, "title": "Quick probe", "type": "DISPATCH", "fanout": "quick_probe",
   "when": ["mode_is:quick"], "job": {"kind": "writer"}, "min_ok": 1},
  {"id": "Q.8", "stage": 10, "title": "Quick decision", "type": "SCRIPT", "script": "quick_decision",
   "when": ["mode_is:quick"], "outputs": ["QUICK_DECISION.md", "08_DECISION.md", "09_PROBE.md"]},

  {"id": "10.1h", "stage": 10, "title": "Red-team picks", "type": "HUMAN", "gate": "G7",
   "when": ["not_quick", "!mode_is:proposal", "hands_on"]},
  {"id": "10.1", "stage": 10, "title": "Top ideas", "type": "SCRIPT", "script": "top", "when": ["not_quick"],
   "outputs": ["07_TOP.md"]},
  {"id": "10.2", "stage": 10, "title": "Pre-commit", "type": "DISPATCH", "fanout": "precommit",
   "when": ["not_quick"], "job": {"kind": "synthesis"}, "min_ok": 1},
  {"id": "10.3", "stage": 10, "title": "Red-team reviews", "type": "DISPATCH", "fanout": "redteam_pairs",
   "when": ["not_quick"], "job": {"kind": "reviewer"}, "min_ok": "1/2"},
  {"id": "10.3r", "stage": 10, "title": "Rebuttals", "type": "DISPATCH", "fanout": "rebuttals", "when": ["deep"],
   "job": {"kind": "reviewer"}, "min_ok": 0},
  {"id": "10.3f", "stage": 10, "title": "Forge the top ideas", "type": "HOST",
   "when": ["deep", "host_can_run_skills", "not_full_auto"],
   "host": {"template": "FORGE", "skills": ["bmad_forge_idea"], "writes": ["redteam/forge_{IDEA}.md"],
            "optional": true}},
  {"id": "10.4", "stage": 10, "title": "Synthesis", "type": "DISPATCH", "fanout": "synthesis",
   "when": ["not_quick"], "job": {"kind": "synthesis"}, "min_ok": 1, "after": ["synthesis_check"]},
  {"id": "10.4x", "stage": 10, "title": "Whole effort", "type": "HUMAN", "gate": "GX",
   "when": ["not_quick", "synthesis_stop"]},
  {"id": "10.5", "stage": 10, "title": "Decide", "type": "HUMAN", "gate": "G8b", "when": ["not_quick"]},
  {"id": "10.6", "stage": 10, "title": "Decision record", "type": "SCRIPT", "script": "decision",
   "when": ["not_quick"], "outputs": ["08_DECISION.md"]},

  {"id": "11.1", "stage": 11, "title": "Probe", "type": "DISPATCH", "fanout": "probe", "when": ["not_quick"],
   "job": {"kind": "writer"}, "min_ok": 1},
  {"id": "11.2", "stage": 11, "title": "Probe result", "type": "HUMAN", "gate": "G9",
   "when": ["not_quick", "hands_on"]},

  {"id": "12.1", "stage": 12, "title": "Architecture brief", "type": "SCRIPT", "script": "arch_brief",
   "outputs": ["10_ARCHITECTURE/00_BRIEF.md", "10_ARCHITECTURE/brief.json"]},
  {"id": "12.a", "stage": 12, "title": "Approach", "type": "DISPATCH", "fanout": "approach",
   "when": ["build_type:approach"], "job": {"kind": "writer"}, "min_ok": 1,
   "outputs": ["10_ARCHITECTURE/approach.md"]},
  {"id": "12.13a", "stage": 12, "title": "Approach review", "type": "DISPATCH", "fanout": "review_lenses",
   "when": ["build_type:approach"], "job": {"kind": "reviewer"}, "min_ok": 0},
  {"id": "12.12a", "stage": 12, "title": "Approach check", "type": "SCRIPT", "script": "approach_after",
   "when": ["build_type:approach"],
   "outputs": ["10_ARCHITECTURE/lint.md", "10_ARCHITECTURE/lint.json", "10_ARCHITECTURE/README.md"]},
  {"id": "12.2", "stage": 12, "title": "Architecture drivers", "type": "DISPATCH", "fanout": "arch_drivers",
   "when": ["build_type:system"], "job": {"kind": "writer"}, "min_ok": 1, "after": ["drivers_after"],
   "outputs": ["10_ARCHITECTURE/goals-constraints.md", "10_ARCHITECTURE/quality-scenarios.md",
               "10_ARCHITECTURE/context.md"]},
  {"id": "12.3", "stage": 12, "title": "Confirm the drivers", "type": "HUMAN", "gate": "G10",
   "when": ["build_type:system"]},
  {"id": "12.4", "stage": 12, "title": "Candidate architectures", "type": "DISPATCH", "fanout": "arch_authors",
   "when": ["build_type:system"], "job": {"kind": "arch-author"}, "min_ok": 2},
  {"id": "12.5", "stage": 12, "title": "Neutral judge sheets", "type": "SCRIPT", "script": "candidates_after",
   "when": ["build_type:system"],
   "outputs": ["10_ARCHITECTURE/candidates/*.json", "10_ARCHITECTURE/review/sheet_*.md"]},
  {"id": "12.6", "stage": 12, "title": "Architecture judges", "type": "DISPATCH", "fanout": "arch_judges",
   "when": ["build_type:system"], "job": {"kind": "arch-judge"}, "min_ok": 1, "after": ["judges_after"]},
  {"id": "12.7", "stage": 12, "title": "Trade-off matrix", "type": "SCRIPT", "script": "arch_matrix",
   "when": ["build_type:system"],
   "outputs": ["10_ARCHITECTURE/tradeoff-matrix.md", "10_ARCHITECTURE/matrix.json"]},
  {"id": "12.8", "stage": 12, "title": "Pre-mortem", "type": "DISPATCH", "fanout": "premortem",
   "when": ["build_type:system", "not_quick"], "job": {"kind": "reviewer"}, "min_ok": 1},
  {"id": "12.9", "stage": 12, "title": "Architecture choice", "type": "HUMAN", "gate": "G11",
   "when": ["build_type:system"]},
  {"id": "12.10", "stage": 12, "title": "Package structure", "type": "DISPATCH", "fanout": "arch_structure",
   "when": ["build_type:system", "not_quick"], "job": {"kind": "writer"}, "min_ok": 1,
   "outputs": ["10_ARCHITECTURE/chosen/*.md", "10_ARCHITECTURE/chosen/api/*"]},
  {"id": "12.10l", "stage": 12, "title": "Package (lite)", "type": "DISPATCH", "fanout": "arch_package_lite",
   "when": ["build_type:system", "mode_is:quick"], "job": {"kind": "writer"}, "min_ok": 1,
   "outputs": ["10_ARCHITECTURE/chosen/*.md", "10_ARCHITECTURE/decisions.json"]},
  {"id": "12.11", "stage": 12, "title": "Cross-cutting, decisions, stack", "type": "DISPATCH",
   "fanout": "arch_parallel", "when": ["build_type:system", "not_quick"], "job": {"kind": "writer"}, "min_ok": 2,
   "after": ["decisions_after"]},
  {"id": "12.11l", "stage": 12, "title": "Stack (lite)", "type": "SCRIPT", "script": "stack_lite",
   "when": ["build_type:system", "mode_is:quick"], "outputs": ["10_ARCHITECTURE/stack.json"]},
  {"id": "12.12", "stage": 12, "title": "Render and lint the package", "type": "SCRIPT", "script": "arch_render_lint",
   "when": ["build_type:system"],
   "outputs": ["10_ARCHITECTURE/adr/*.md", "10_ARCHITECTURE/risks.md", "10_ARCHITECTURE/chosen/stack.md",
               "10_ARCHITECTURE/lint.md", "10_ARCHITECTURE/lint.json", "10_ARCHITECTURE/README.md"]},
  {"id": "12.13", "stage": 12, "title": "Review lenses", "type": "DISPATCH", "fanout": "review_lenses",
   "when": ["build_type:system", "not_quick"], "job": {"kind": "reviewer"}, "min_ok": 0},
  {"id": "12.14", "stage": 12, "title": "Fix the package", "type": "DISPATCH", "fanout": "arch_fix",
   "when": ["build_type:system", "not_quick"], "job": {"kind": "fixer"}, "min_ok": 0,
   "after": ["arch_fix_after"]},
  {"id": "12.14b", "stage": 12, "title": "Fix the package (second pass)", "type": "DISPATCH", "fanout": "arch_fix",
   "when": ["build_type:system", "deep"], "job": {"kind": "fixer"}, "min_ok": 0, "after": ["arch_fix_after"]},
  {"id": "12.15", "stage": 12, "title": "Architecture README", "type": "SCRIPT", "script": "arch_readme",
   "when": ["build_type:system"], "outputs": ["10_ARCHITECTURE/README.md"]},
  {"id": "12.16", "stage": 12, "title": "ADRs", "type": "HUMAN", "gate": "G12", "when": ["build_type:system"]},

  {"id": "13.1", "stage": 13, "title": "Evidence packs", "type": "SCRIPT", "script": "proposal_packs",
   "outputs": ["11_PROPOSAL/_packs/*.md"]},
  {"id": "13.2", "stage": 13, "title": "Proposal sections", "type": "DISPATCH", "fanout": "proposal_parts",
   "when": ["not_quick"], "job": {"kind": "writer"}, "min_ok": 3, "outputs": ["11_PROPOSAL/sections/*.md"]},
  {"id": "13.2l", "stage": 13, "title": "Proposal (lite)", "type": "DISPATCH", "fanout": "proposal_lite",
   "when": ["mode_is:quick"], "job": {"kind": "writer"}, "min_ok": 1,
   "outputs": ["11_PROPOSAL/sections/*.md", "11_PROPOSAL/ONE-PAGER.md"]},
  {"id": "13.3", "stage": 13, "title": "One-pager", "type": "DISPATCH", "fanout": "onepager", "when": ["not_quick"],
   "job": {"kind": "writer"}, "min_ok": 1, "outputs": ["11_PROPOSAL/ONE-PAGER.md", "11_PROPOSAL/PRFAQ.md"]},
  {"id": "13.4", "stage": 13, "title": "Assemble the proposal", "type": "SCRIPT", "script": "proposal_assemble",
   "outputs": ["11_PROPOSAL/PROPOSAL.md", "11_PROPOSAL/assumptions.md", "11_PROPOSAL/open-questions.md",
               "11_PROPOSAL/lint.md", "11_PROPOSAL/lint.json", "11_PROPOSAL/README.md"]},
  {"id": "13.5", "stage": 13, "title": "Rubric and red-team", "type": "DISPATCH", "fanout": "proposal_review",
   "job": {"kind": "rubric"}, "min_ok": 1},
  {"id": "13.6", "stage": 13, "title": "Fix the proposal", "type": "DISPATCH", "fanout": "proposal_fix",
   "when": ["!mode_is:quick|fix_requested"], "job": {"kind": "fixer"}, "min_ok": 0},
  {"id": "13.4b", "stage": 13, "title": "Assemble again", "type": "SCRIPT", "script": "proposal_assemble",
   "when": ["step_done:13.6"]},
  {"id": "13.7", "stage": 13, "title": "HTML pack", "type": "SCRIPT", "script": "proposal_render",
   "outputs": ["11_PROPOSAL/index.html"]},
  {"id": "13.8", "stage": 13, "title": "Sign-off", "type": "HUMAN", "gate": "G13"},
  {"id": "13.9", "stage": 13, "title": "Final proposal", "type": "SCRIPT", "script": "proposal_assemble",
   "after": ["proposal_render"]},

  {"id": "14.1", "stage": 14, "title": "Merge domain terms", "type": "HOST",
   "when": ["repo_variant", "context_proposed", "host_can_run_skills", "not_full_auto"],

   "after": ["context_merge_after"]},
  {"id": "14.2", "stage": 14, "title": "Handoff", "type": "HUMAN", "gate": "G14"},
  {"id": "14.3", "stage": 14, "title": "Handoff seed", "type": "SCRIPT", "script": "handoff_seed",

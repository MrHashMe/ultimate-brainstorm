{
 "$id": "quick-curated",
 "description": "QUICK-CURATE output (bs.py quick-pick reads it)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "ideas"
 ],
 "properties": {
  "ideas": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "pitch",
     "mechanism",
     "cluster",
     "aliases",
     "gates",
     "scores",
     "fails_if",
     "problem",
     "for_whom",
     "first_version"
    ],
    "properties": {
     "id": {
      "type": "string",
      "description": "Q-01, Q-02, ..."
     },
     "title": {
      "type": "string"
     },
     "pitch": {
      "type": "string"
     },
     "mechanism": {
      "type": "string"
     },
     "cluster": {
      "type": "string"
     },
     "aliases": {
      "type": "array",
      "description": "the source idea IDs merged into this idea, exactly as written (QA-01, QB-07, H-2, HP-1)",
      "items": {
       "type": "string"
      }
     },
     "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "g1",
       "g2",
       "g3"
      ],
      "properties": {
       "g1": {
        "type": "boolean",
        "description": "hard constraints respected"
       },
       "g2": {
        "type": "boolean",
        "description": "legal, ethical, safe"
       },
       "g3": {
        "type": "boolean",
        "description": "problem and insight each statable in one sentence"
       }
      }
     },
     "scores": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "criterion",
        "score"
       ],
       "properties": {
        "criterion": {
         "type": "string",
         "description": "criterion name exactly as given"
        },
        "score": {
         "type": "integer",
         "minimum": 1,
         "maximum": 5,
         "description": "1-5"
        }
       }
      }
     },
     "fails_if": {
      "type": "string",
      "description": "the most likely way it dies, one line"
     },
     "problem": {
      "type": "string",
      "description": "one sentence"
     },
     "for_whom": {
      "type": "string"
     },
     "first_version": {
      "type": "string",
      "description": "one sentence"
     }
    }
   }
  }
 }
}
